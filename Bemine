<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Massage for Mpilonhle</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Great+Vibes&family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Dancing+Script:wght@500;700&display=swap');

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  body {
    min-height: 100vh;
    background: linear-gradient(135deg, #1a0a12 0%, #2d0f1f 40%, #4a1535 100%);
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 20px;
    overflow-x: hidden;
    position: relative;
    font-family: 'Playfair Display', serif;
  }

  /* Floating hearts */
  .heart {
    position: absolute;
    font-size: 20px;
    color: #ff6b9d;
    opacity: 0.6;
    animation: float 12s linear infinite;
    pointer-events: none;
    z-index: 0;
  }

  @keyframes float {
    0% { transform: translateY(100vh) rotate(0deg); opacity: 0; }
    10% { opacity: 0.7; }
    90% { opacity: 0.5; }
    100% { transform: translateY(-10vh) rotate(360deg); opacity: 0; }
  }

  .container {
    max-width: 680px;
    width: 100%;
    background: rgba(255, 240, 245, 0.97);
    border-radius: 28px;
    padding: 45px 40px 50px;
    box-shadow: 
      0 25px 50px rgba(0,0,0,0.4),
      0 0 0 1px rgba(255, 182, 193, 0.3),
      inset 0 0 40px rgba(255, 192, 203, 0.15);
    position: relative;
    z-index: 10;
    animation: fadeIn 1.4s ease-out;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(30px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .heading {
    text-align: center;
    font-family: 'Great Vibes', cursive;
    font-size: 3.2rem;
    color: #8b1a4a;
    margin-bottom: 8px;
    text-shadow: 0 2px 8px rgba(139, 26, 74, 0.2);
    letter-spacing: 1px;
  }

  .subheading {
    text-align: center;
    font-family: 'Dancing Script', cursive;
    font-size: 1.35rem;
    color: #c45c7a;
    margin-bottom: 30px;
  }

  .poem {
    background: linear-gradient(to right, #fff0f5, #ffe4ec);
    border-left: 5px solid #e83e8c;
    padding: 22px 26px;
    margin: 25px 0;
    border-radius: 0 16px 16px 0;
    font-style: italic;
    color: #5a2a3a;
    line-height: 1.7;
    font-size: 1.08rem;
    position: relative;
  }

  .poem::before {
    content: "❝";
    font-size: 3.5rem;
    color: #e83e8c;
    opacity: 0.25;
    position: absolute;
    top: -5px;
    left: 12px;
  }

  .message {
    font-size: 1.12rem;
    color: #4a2c3a;
    line-height: 1.75;
    margin: 28px 0;
    text-align: center;
  }

  .message .dear {
    font-family: 'Dancing Script', cursive;
    font-size: 1.6rem;
    color: #b03060;
    display: block;
    margin-bottom: 12px;
  }

  .paper-note {
    background: #fffaf0;
    border: 1px dashed #e8a0b0;
    padding: 18px 22px;
    margin: 22px auto;
    max-width: 420px;
    border-radius: 12px;
    font-family: 'Dancing Script', cursive;
    font-size: 1.25rem;
    color: #8b3a5a;
    text-align: center;
    box-shadow: 2px 3px 0 rgba(232, 160, 176, 0.3);
    transform: rotate(-1.5deg);
  }

  .countdown-section {
    text-align: center;
    margin: 35px 0 25px;
  }

  .countdown-label {
    font-family: 'Dancing Script', cursive;
    font-size: 1.4rem;
    color: #c45c7a;
    margin-bottom: 15px;
  }

  .countdown {
    display: flex;
    justify-content: center;
    gap: 14px;
    flex-wrap: wrap;
  }

  .time-box {
    background: linear-gradient(145deg, #ff6b9d, #c44569);
    color: white;
    border-radius: 16px;
    padding: 14px 10px;
    min-width: 75px;
    box-shadow: 0 8px 20px rgba(196, 69, 105, 0.35);
    animation: pulse 2.5s ease-in-out infinite;
  }

  .time-box:nth-child(2) { animation-delay: 0.3s; }
  .time-box:nth-child(3) { animation-delay: 0.6s; }
  .time-box:nth-child(4) { animation-delay: 0.9s; }

  @keyframes pulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.05); }
  }

  .time-value {
    font-size: 1.85rem;
    font-weight: 700;
    display: block;
    line-height: 1.1;
  }

  .time-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    opacity: 0.9;
    margin-top: 4px;
  }

  .question {
    text-align: center;
    margin-top: 40px;
    padding-top: 25px;
    border-top: 1px solid #f0c8d4;
  }

  .question h3 {
    font-family: 'Great Vibes', cursive;
    font-size: 2.4rem;
    color: #8b1a4a;
    margin-bottom: 22px;
  }

  .buttons {
    display: flex;
    justify-content: center;
    gap: 18px;
    flex-wrap: wrap;
  }

  .btn {
    padding: 14px 32px;
    font-size: 1.15rem;
    font-family: 'Dancing Script', cursive;
    border: none;
    border-radius: 50px;
    cursor: pointer;
    transition: all 0.3s ease;
    font-weight: 700;
  }

  .btn-yes {
    background: linear-gradient(135deg, #ff6b9d, #e83e8c);
    color: white;
    box-shadow: 0 6px 18px rgba(232, 62, 140, 0.4);
  }

  .btn-yes:hover {
    transform: translateY(-3px) scale(1.05);
    box-shadow: 0 10px 25px rgba(232, 62, 140, 0.55);
  }

  .btn-think {
    background: linear-gradient(135deg, #f8c8d8, #f0a0b8);
    color: #8b1a4a;
    box-shadow: 0 6px 15px rgba(240, 160, 184, 0.35);
  }

  .btn-think:hover {
    transform: translateY(-3px) scale(1.05);
    box-shadow: 0 10px 22px rgba(240, 160, 184, 0.5);
  }

  .response-msg {
    margin-top: 25px;
    font-family: 'Dancing Script', cursive;
    font-size: 1.5rem;
    color: #b03060;
    min-height: 40px;
    opacity: 0;
    transition: opacity 0.6s ease;
  }

  .response-msg.show {
    opacity: 1;
  }

  .footer-hearts {
    text-align: center;
    margin-top: 30px;
    font-size: 1.4rem;
    letter-spacing: 8px;
    opacity: 0.7;
  }

  @media (max-width: 500px) {
    .heading { font-size: 2.5rem; }
    .container { padding: 30px 22px 40px; }
    .time-box { min-width: 65px; padding: 12px 8px; }
    .time-value { font-size: 1.5rem; }
  }
</style>
</head>
<body>

<!-- Floating hearts -->
<div id="hearts"></div>

<div class="container">
  <h1 class="heading">Massage for Mpilonhle</h1>
  <p class="subheading">A soft whisper from the heart</p>

  <div class="poem">
    In quiet nights I held your name,<br>
    A secret flame I dared not claim.<br>
    Last year the words stayed locked inside,<br>
    The biggest silence of my life.<br><br>
    That little paper carried truth,<br>
    Soft ink of longing, pure and youth.<br>
    Now time has taught me not to wait—<br>
    My heart still beats for you, my fate.
  </div>

  <div class="message">
    <span class="dear">Dear Bitso,</span>
    I wish I had more time with you ❤️🥺<br><br>
    Last year I had a crush on you,<br>
    but I decided to keep my mouth shut…<br>
    and that became my biggest mistake.<br><br>
    The small paper I wrote to you<br>
    carried everything I feel 🥺🥺
  </div>

  <div class="paper-note">
    “I still feel the same… maybe even more.”
  </div>

  <div class="countdown-section">
    <p class="countdown-label">⏳ Four years from this moment…</p>
    <div class="countdown" id="countdown">
      <div class="time-box">
        <span class="time-value" id="years">0</span>
        <span class="time-label">Years</span>
      </div>
      <div class="time-box">
        <span class="time-value" id="days">0</span>
        <span class="time-label">Days</span>
      </div>
      <div class="time-box">
        <span class="time-value" id="hours">0</span>
        <span class="time-label">Hours</span>
      </div>
      <div class="time-box">
        <span class="time-value" id="mins">0</span>
        <span class="time-label">Mins</span>
      </div>
    </div>
  </div>

  <div class="question">
    <h3>Will you be mine?</h3>
    <div class="buttons">
      <button class="btn btn-yes" onclick="answer('yes')">Yes ❤️</button>
      <button class="btn btn-think" onclick="answer('think')">I’ll think about it 🥺</button>
    </div>
    <div class="response-msg" id="response"></div>
  </div>

  <div class="footer-hearts">♥ ♥ ♥</div>
</div>

<script>
  // Create floating hearts
  const heartsContainer = document.getElementById('hearts');
  const heartSymbols = ['❤️', '💕', '💗', '💖', '💘', '✨'];

  for (let i = 0; i < 18; i++) {
    const heart = document.createElement('div');
    heart.className = 'heart';
    heart.innerHTML = heartSymbols[Math.floor(Math.random() * heartSymbols.length)];
    heart.style.left = Math.random() * 100 + 'vw';
    heart.style.animationDuration = (8 + Math.random() * 10) + 's';
    heart.style.animationDelay = Math.random() * 8 + 's';
    heart.style.fontSize = (16 + Math.random() * 18) + 'px';
    heartsContainer.appendChild(heart);
  }

  // Countdown: exactly 4 years from now
  const targetDate = new Date();
  targetDate.setFullYear(targetDate.getFullYear() + 4);

  function updateCountdown() {
    const now = new Date();
    const diff = targetDate - now;

    if (diff <= 0) {
      document.getElementById('years').textContent = '0';
      document.getElementById('days').textContent = '0';
      document.getElementById('hours').textContent = '0';
      document.getElementById('mins').textContent = '0';
      return;
    }

    const years = Math.floor(diff / (1000 * 60 * 60 * 24 * 365.25));
    const days = Math.floor((diff % (1000 * 60 * 60 * 24 * 365.25)) / (1000 * 60 * 60 * 24));
    const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
    const mins = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));

    document.getElementById('years').textContent = years;
    document.getElementById('days').textContent = days;
    document.getElementById('hours').textContent = hours;
    document.getElementById('mins').textContent = mins;
  }

  updateCountdown();
  setInterval(updateCountdown, 1000);

  function answer(choice) {
    const msg = document.getElementById('response');
    if (choice === 'yes') {
      msg.innerHTML = "My heart just skipped a beat… ❤️<br>You just made me the happiest person.";
    } else {
      msg.innerHTML = "I’ll wait as long as it takes… 🥺💕<br>Take all the time you need.";
    }
    msg.classList.add('show');
  }
</script>

</body>
</html>
